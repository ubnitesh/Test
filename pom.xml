<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>com.nokia.powehi.rapp</groupId>
    <artifactId>rapp-starter-kit</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>rApp Starter Kit</name>
    <description>Spring Boot scaffold modeled after O-RAN SC Non-RT RIC rApp Manager</description>

    <modules>
        <module>rapp-manager-models</module>
        <module>rapp-manager-dme</module>
        <module>rapp-manager-acm</module>
        <module>rapp-manager-sme</module>
        <module>rapp-manager-application</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <spring.statemachine.version>4.0.1</spring.statemachine.version>
        <openapi.jackson.databind.nullable.version>0.2.6</openapi.jackson.databind.nullable.version>
        <io.swagger.version>2.2.36</io.swagger.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
